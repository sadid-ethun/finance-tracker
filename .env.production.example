# Production environment for the VM. Copy to `.env` next to
# docker-compose.prod.yml, fill in every value, and `chmod 600` it.
#
# This file is the example. The real `.env` is gitignored and must never be
# committed — it holds the key that decrypts your bank access tokens.
#
# Generate the two secrets fresh. Do NOT promote the values from
# apps/api/.env: those have sat in plaintext on a laptop through development,
# which is fine for sandbox data and not fine for real bank data.
#
#   BETTER_AUTH_SECRET     openssl rand -base64 32
#   PLAID_ENCRYPTION_KEY   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ---- host -------------------------------------------------------------------
# Public hostname, no scheme and no trailing slash. Its A record must already
# point at this VM or Caddy cannot obtain a certificate.
DOMAIN=finance.example.com
# Let's Encrypt uses this only for expiry warnings.
ACME_EMAIL=you@example.com

# ---- datastore --------------------------------------------------------------
POSTGRES_PASSWORD=

# ---- auth -------------------------------------------------------------------
BETTER_AUTH_SECRET=

# ---- plaid ------------------------------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Comma-separated. The first key encrypts, the rest only decrypt, which is what
# makes rotation possible without downtime.
#
# Back this up somewhere outside this VM and outside the repo. It is not in
# database dumps. Lose it and every connected bank must be re-linked, because
# the stored access tokens become permanently undecryptable.
PLAID_ENCRYPTION_KEY=

# ---- optional ---------------------------------------------------------------
SENTRY_DSN=
