# Copy to .env and fill in. Never commit the real .env.

# ---- shared ----------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true

# ---- database / cache ------------------------------------------------------
# One connection string for both apps. The web app's `pg` client uses it as-is;
# the API rewrites it to the asyncpg driver automatically.
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance
REDIS_URL=redis://localhost:6379/0

# ---- api -------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]
# Where the API fetches JWKS and which issuer/audience it demands. Must match
# BETTER_AUTH_URL below, or every request fails verification.
WEB_URL=http://localhost:3000
JWT_AUDIENCE=finance-tracker-api

# ---- web -------------------------------------------------------------------
# Internal address of the API service. In Docker this is http://api:8000.
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-value
BETTER_AUTH_URL=http://localhost:3000

# Used once by `pnpm --filter web seed:owner`; signup is disabled, so this is
# the only way the owner account is created. Remove after seeding.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# ---- plaid -----------------------------------------------------------------
# From dashboard.plaid.com -> Developers -> Keys. Use the Sandbox secret.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Encrypts Plaid access tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated for rotation: the FIRST key encrypts, the rest only decrypt.
# Losing this key means every connected bank must be re-linked.
PLAID_ENCRYPTION_KEY=

# Public HTTPS URL Plaid posts webhooks to, e.g. https://api.example.com/webhooks/plaid
# Leave empty locally — there is no inbound route from the internet, and the
# hourly worker sync covers what webhooks would have delivered.
PLAID_WEBHOOK_URL=
